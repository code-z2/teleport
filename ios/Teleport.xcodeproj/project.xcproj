{
  "default-configuration": "Debug",
  "configurations": [
    { "name": "Debug", "file": "Config/Teleport.xcconfig" },
    { "name": "Release", "file": "Config/Teleport.xcconfig" },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/firebase/firebase-ios-sdk",
      "version": {
        "up-to-next-major-version": "12.0.0",
      },
    }, {
      "kind": "local",
      "path": "Packages/TeleportCore",
    },
  ],
  "files": [
    {
      "kind": "group",
      "path": "ActionExtension",
      "children": [
        { "path": "Info.plist" },
        { "path": "TeleportAction.entitlements" },
      ],
    }, {
      "kind": "group",
      "path": "Config",
      "children": [
        { "path": "Teleport.xcconfig" },
      ],
    }, {
      "kind": "group",
      "path": "ExtensionSupport",
      "children": [
        {
          "path": "ClipExtractor.swift",
          "target-membership": [
            "TeleportAction/compile-sources",
            "TeleportShare/compile-sources",
          ],
        }, {
          "path": "SendPicker.swift",
          "target-membership": [
            "TeleportAction/compile-sources",
            "TeleportShare/compile-sources",
          ],
        }, {
          "path": "ShareSuggestion.swift",
          "target-membership": [
            "Teleport/compile-sources",
            "TeleportAction/compile-sources",
            "TeleportShare/compile-sources",
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "LiveActivity",
      "children": [
        { "path": "ClipLiveActivity.swift", "target-membership": [ "TeleportLiveActivity/compile-sources" ] },
        { "path": "Info.plist" },
        { "path": "TeleportLiveActivity.entitlements" },
      ],
    }, {
      "kind": "group",
      "path": "NotificationService",
      "children": [
        { "path": "Info.plist" },
        { "path": "NotificationService.swift", "target-membership": [ "TeleportNotificationService/compile-sources" ] },
        { "path": "TeleportNotificationService.entitlements" },
      ],
    }, {
      "kind": "group",
      "path": "Packages",
      "children": [
        { "path": "<PROJECT>/Packages/TeleportCore" },
      ],
    }, {
      "kind": "group",
      "path": "Shared",
      "children": [
        {
          "path": "ClipActivity.swift",
          "target-membership": [
            "Teleport/compile-sources",
            "TeleportLiveActivity/compile-sources",
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "ShareExtension",
      "children": [
        { "path": "Info.plist" },
        {
          "path": "ShareViewController.swift",
          "target-membership": [
            "TeleportAction/compile-sources",
            "TeleportShare/compile-sources",
          ],
        },
        { "path": "TeleportShare.entitlements" },
      ],
    }, {
      "kind": "group",
      "path": "Teleport",
      "children": [
        { "path": "AppIcon.icon", "target-membership": [ "Teleport/resources" ] },
        { "path": "ContentView.swift", "target-membership": [ "Teleport/compile-sources" ] },
        { "path": "GoogleService-Info.plist", "target-membership": [ "Teleport/resources" ] },
        { "path": "Info.plist" },
        { "path": "MacBrowser.swift", "target-membership": [ "Teleport/compile-sources" ] },
        { "path": "Teleport.entitlements" },
        { "path": "TeleportApp.swift", "target-membership": [ "Teleport/compile-sources" ] },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "<SDK>/System/Library/Frameworks/SwiftUI.framework", "target-membership": [ "TeleportLiveActivity/frameworks" ] },
        { "path": "<SDK>/System/Library/Frameworks/WidgetKit.framework", "target-membership": [ "TeleportLiveActivity/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Teleport.app", "id": "8789D60011F8B14C7DD9B4D4", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/TeleportAction.appex", "id": "973D3B22FFE86166294C7C75", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Teleport/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/TeleportLiveActivity.appex", "id": "21CDC007BB172C2E137A20D9", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Teleport/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/TeleportNotificationService.appex", "id": "C701AA53418072B9E1145F23", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Teleport/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/TeleportShare.appex", "id": "35E30A6D815AAE7632797490", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Teleport/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "Teleport",
      "id": "E9D2FB19E170DD28624947A5",
      "product": "Products/Teleport.app",
      "product-type": "application",
      "legacy-provisioning-style": "automatic",
      "legacy-team-id": "$(TELEPORT_TEAM_ID)",
      "dependencies": [
        "TeleportAction",
        "TeleportShare",
        "TeleportNotificationService",
        "TeleportLiveActivity",
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "product-name": "TeleportCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "firebase-ios-sdk",
          "product-name": "FirebaseMessaging",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS": "Teleport/Teleport.entitlements",
        "CODE_SIGN_IDENTITY": "iPhone Developer",
        "INFOPLIST_FILE": "Teleport/Info.plist",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "$(TELEPORT_BUNDLE_ID)",
        "SDKROOT": "iphoneos",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "TeleportAction",
      "id": "3BB75B2801EC7E87193E936E",
      "product": "Products/TeleportAction.appex",
      "product-type": "app-extension",
      "legacy-provisioning-style": "automatic",
      "legacy-team-id": "$(TELEPORT_TEAM_ID)",
      "build-phases": [
        "compile-sources",
        "frameworks",
      ],
      "package-product-members": [
        {
          "product-name": "TeleportCore",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS": "ActionExtension/TeleportAction.entitlements",
        "INFOPLIST_FILE": "ActionExtension/Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "$(TELEPORT_BUNDLE_ID).action",
        "SDKROOT": "iphoneos",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "TeleportShare",
      "id": "6554B362FC6C440FD281AC11",
      "product": "Products/TeleportShare.appex",
      "product-type": "app-extension",
      "legacy-provisioning-style": "automatic",
      "legacy-team-id": "$(TELEPORT_TEAM_ID)",
      "build-phases": [
        "compile-sources",
        "frameworks",
      ],
      "package-product-members": [
        {
          "product-name": "TeleportCore",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS": "ShareExtension/TeleportShare.entitlements",
        "INFOPLIST_FILE": "ShareExtension/Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "$(TELEPORT_BUNDLE_ID).share",
        "SDKROOT": "iphoneos",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "TeleportNotificationService",
      "id": "16D54876910F1E6C9AF062E0",
      "product": "Products/TeleportNotificationService.appex",
      "product-type": "app-extension",
      "legacy-provisioning-style": "automatic",
      "legacy-team-id": "$(TELEPORT_TEAM_ID)",
      "build-phases": [
        "compile-sources",
        "frameworks",
      ],
      "package-product-members": [
        {
          "product-name": "TeleportCore",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS": "NotificationService/TeleportNotificationService.entitlements",
        "INFOPLIST_FILE": "NotificationService/Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "$(TELEPORT_BUNDLE_ID).nse",
        "SDKROOT": "iphoneos",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "TeleportLiveActivity",
      "id": "AAE10BA54F8412DACC8A87FC",
      "product": "Products/TeleportLiveActivity.appex",
      "product-type": "app-extension",
      "legacy-provisioning-style": "automatic",
      "legacy-team-id": "$(TELEPORT_TEAM_ID)",
      "build-phases": [
        "compile-sources",
        "frameworks",
      ],
      "package-product-members": [
        {
          "product-name": "TeleportCore",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS": "LiveActivity/TeleportLiveActivity.entitlements",
        "INFOPLIST_FILE": "LiveActivity/Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "$(TELEPORT_BUNDLE_ID).liveactivity",
        "SDKROOT": "iphoneos",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++14",
    "CLANG_CXX_LIBRARY": "libc++",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DIRECT_OBJC_ISA_USAGE": "YES_ERROR",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_ROOT_CLASS": "YES_ERROR",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNGUARDED_AVAILABILITY": "YES_AGGRESSIVE",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "CODE_SIGN_STYLE": "Automatic",
    "COPY_PHASE_STRIP": "NO",
    "CURRENT_PROJECT_VERSION": "1",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "DEVELOPMENT_TEAM": "$(TELEPORT_TEAM_ID)",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu11",
    "GCC_DYNAMIC_NO_PIC[config=Debug]": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "$(inherited)",
      "DEBUG=1",
    ],
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES_ERROR",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "IPHONEOS_DEPLOYMENT_TARGET": "18.0",
    "MARKETING_VERSION": "0.1.0",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "INCLUDE_SOURCE",
    "MTL_ENABLE_DEBUG_INFO[config=Release]": "NO",
    "MTL_FAST_MATH": "YES",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "PRODUCT_NAME": "$(TARGET_NAME)",
    "SDKROOT": "iphoneos",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
    "SWIFT_VERSION": "6.0",
    "TARGETED_DEVICE_FAMILY": "1",
  },
  "last-upgrade": "16.0",
}
