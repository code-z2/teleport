<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Large file transfers (up to 250 MB) run as a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".TeleportApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Teleport"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- Declares the Direct Share target (paired device in the share sheet's top row). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Large files, both ways, with a progress notification. -->
        <service
            android:name=".TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Quick Settings tile: teleport what you copied. -->
        <service
            android:name=".ClipboardTile"
            android:exported="true"
            android:icon="@drawable/ic_stat_teleport"
            android:label="Teleport"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="false" />
        </service>

        <!-- Invisible: reads the clipboard for the tile (only a focused app may), then sends. -->
        <activity
            android:name=".ClipboardSendActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="Teleport"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Teleport.Transparent" />

        <!-- Browse a paired Mac's files. -->
        <activity
            android:name=".MacBrowserActivity"
            android:exported="false"
            android:label="Mac files" />

        <!-- No-UI share target: encrypt, send, toast, finish. -->
        <activity
            android:name=".ShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="Teleport"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Teleport.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- Any other file (videos, PDFs, documents…), up to 250 MB. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".MessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Received images are shared to the clipboard as content:// URIs. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.clips"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/clip_paths" />
        </provider>
        <!-- "Save" button on image notifications. -->
        <receiver
            android:name=".SaveImageReceiver"
            android:exported="false" />
        <!-- Allow / Deny on pairing requests. -->
        <receiver
            android:name=".PairActionReceiver"
            android:exported="false" />
    </application>
</manifest>
