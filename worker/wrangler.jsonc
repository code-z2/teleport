{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teleport-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Blind relay: no request logging, no traces.
  "observability": { "enabled": false },
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "teleport-blobs" }],
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ]
  // Secrets (set with `wrangler secret put`): RELAY_KEY, FCM_SERVICE_ACCOUNT
}
