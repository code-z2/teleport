{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2022"],
    "types": ["./worker-configuration.d.ts"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src", "test"],
  // Runs under Node (see vitest.config.ts), not the Workers runtime these types describe.
  "exclude": ["test/worker.test.ts", "test/stubs"]
}
