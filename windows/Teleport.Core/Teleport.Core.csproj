<Project Sdk="Microsoft.NET.Sdk">
  <!-- The protocol, crypto, relay client, mailbox connection and file server. Platform-neutral:
       Windows specifics (TPM keys, clipboard, thumbnails, tray) live in Teleport.Windows. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Teleport.Core</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
