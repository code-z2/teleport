<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows tray app: TPM keys, clipboard, notifications, thumbnails, Send To. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Teleport</AssemblyName>
    <RootNamespace>Teleport.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFO5001;WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- WPF is the UI; WinForms only supplies the tray icon, so keep its names out of scope. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Teleport.Core\Teleport.Core.csproj" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="relay.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
