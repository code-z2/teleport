<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed: file sessions (phase 5) need the whole home folder.
	     The keychain group gives the app an application identifier, which the Secure Enclave
	     and the modern keychain need on macOS. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(TELEPORT_BUNDLE_ID).mac</string>
	</array>
</dict>
</plist>
